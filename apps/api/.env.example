# Kopyala: cp apps/api/.env.example apps/api/.env  (.env commit edilmez)
# Değişkenler apps/api/src/config.ts içinde doğrulanır.

# Zorunlu: development | test | production. Verilmezse API başlamaz.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# X-Forwarded-For'a hangi vekilden güvenileceği. Boş/false: hiçbiri (varsayılan).
# Tamsayı: önündeki vekil sayısı (ör. 1). Ya da vekil IP/CIDR listesi (ör. 10.0.0.0/8,127.0.0.1).
# true kabul edilmez: başlığı istemci de yazabilir, hız sınırı atlatılır.
TRUST_PROXY=

# compose.yaml'daki yerel PostgreSQL 16 (host portu 5433). db:migrate bu adresle çalışır ve rol
# veritabanının sahibi olmalıdır: 0010 migration'ı `create extension btree_gin` ister (güvenilir
# eklenti; süper kullanıcı gerekmez). Yerel `kampus` rolü sahiptir (veritabani.md §5).
DATABASE_URL=postgres://kampus:kampus-yerel@127.0.0.1:5433/kampus

# En az 32 karakter rastgele değer: openssl rand -base64 32
# CHANGE_ME ile başlayan değer üretimde reddedilir.
BETTER_AUTH_SECRET=CHANGE_ME-en-az-32-karakter-rastgele-deger
# API'nin dışarıdan görünen kök adresi; üretimde zorunlu.
BETTER_AUTH_URL=http://localhost:3000

# Virgülle ayrılmış izinli web kökenleri (tam eşleşme); CORS ve Better Auth aynı listeyi kullanır.
# web-react geliştirme (5174) ve önizleme (4174) sunucuları API'yi /api vekiliyle aynı kökenden
# çağırır; tarayıcının gönderdiği Origin bu sunucularınki olduğu için listede bulunur.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://127.0.0.1:4174
# Web uygulamasının dışarıdan görünen kök adresi. Parola sıfırlama bağlantısı
# (/parola-sifirla#token=…) bu adrese kurulur. Boşsa geliştirmede http://localhost:5174;
# üretimde boşsa sıfırlama iletisi gönderilmez (e-posta sağlayıcısı ayrı görevdir: OG-095).
WEB_URL=http://localhost:5174
# E-posta göndericisi: log (bağlantıyı belirteciyle loga yazar; yalnız yerel geliştirme), memory
# (test), none (hiçbir şey göndermez, uyarı loglar). Boşsa geliştirmede log, testte memory,
# üretimde none; üretimde log ve memory reddedilir (belirteç üretim loguna girmesin).
# Gerçek sağlayıcı OG-095'tedir.
MAIL_DRIVER=
# Mobil uygulama şeması gibi tarayıcı dışı güvenilen kökenler.
TRUSTED_ORIGINS=kampus://

# Dosya deposu (ADR 0003). Bugün yalnız `disk`; S3 uyumlu sürücü sonraki adımdadır.
STORAGE_DRIVER=disk
# Disk deposunun kök klasörü (göreliyse apps/api'ye göre); boşsa var/storage. Disk sürücüsü yalnız
# test ve yerel geliştirme içindir: NODE_ENV=production ile seçilirse API başlangıçta açık bir
# hatayla durur (S3 sürücüsü gelene kadar). İndirme bağlantısı API'nin kendi ucudur (HMAC imzalı,
# süreli); imza anahtarı BETTER_AUTH_SECRET'tan türetilir, ayrı sır gerekmez.
STORAGE_DIR=var/storage

# Arka plan iş kuyruğu (pg-boss; zamanlanmış temizlik ve hatırlatma işleri). Boşsa geliştirme ve
# üretimde açık, testte kapalı. Kuyruk DATABASE_URL veritabanında kendi `pgboss` şemasını açılışta
# kurar ve yükseltir; rolün veritabanında şema açma yetkisi olmalıdır (yerel `kampus` sahiptir).
JOBS_ENABLED=

# Ses dönüştürme (media.transcode; ADR 0003 karar 10): ffmpeg ve ffprobe ikilisinin yolu ya da
# PATH'teki adı. Boşsa ffmpeg ve ffprobe. Yerelde: brew install ffmpeg (Debian: apt install ffmpeg).
# İkili yoksa dönüşüm geçici hatayla yeniden denenir; son denemede ses dosyası reddedilir.
FFMPEG_PATH=
FFPROBE_PATH=

# Yalnız db:seed. Boşsa üretim dışında varsayılan demo parolası kullanılır; üretimde zorunlu.
DEMO_PASSWORD=
