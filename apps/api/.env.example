# Kopyala: cp apps/api/.env.example apps/api/.env  (.env commit edilmez)
# Değişkenler apps/api/src/config.ts içinde doğrulanır.

# Zorunlu: development | test | production. Verilmezse API başlamaz.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# X-Forwarded-For'a hangi vekilden güvenileceği. Boş/false: hiçbiri (varsayılan).
# Tamsayı: önündeki vekil sayısı (ör. 1). Ya da vekil IP/CIDR listesi (ör. 10.0.0.0/8,127.0.0.1).
# true kabul edilmez: başlığı istemci de yazabilir, hız sınırı atlatılır.
TRUST_PROXY=

# compose.yaml'daki yerel PostgreSQL 16 (host portu 5433). db:migrate bu adresle çalışır ve rol
# veritabanının sahibi olmalıdır: 0010 migration'ı `create extension btree_gin` ister (güvenilir
# eklenti; süper kullanıcı gerekmez). Yerel `kampus` rolü sahiptir (veritabani.md §5).
DATABASE_URL=postgres://kampus:kampus-yerel@127.0.0.1:5433/kampus

# En az 32 karakter rastgele değer: openssl rand -base64 32
# CHANGE_ME ile başlayan değer üretimde reddedilir.
BETTER_AUTH_SECRET=CHANGE_ME-en-az-32-karakter-rastgele-deger
# API'nin dışarıdan görünen kök adresi; üretimde zorunlu.
BETTER_AUTH_URL=http://localhost:3000

# Virgülle ayrılmış izinli web kökenleri (tam eşleşme); CORS ve Better Auth aynı listeyi kullanır.
# web-react geliştirme (5174) ve önizleme (4174) sunucuları API'yi /api vekiliyle aynı kökenden
# çağırır; tarayıcının gönderdiği Origin bu sunucularınki olduğu için listede bulunur.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://127.0.0.1:4174
# Mobil uygulama şeması gibi tarayıcı dışı güvenilen kökenler.
TRUSTED_ORIGINS=kampus://

# Yalnız db:seed. Boşsa üretim dışında varsayılan demo parolası kullanılır; üretimde zorunlu.
DEMO_PASSWORD=
