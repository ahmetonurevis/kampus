# Kopyala: cp apps/api/.env.example apps/api/.env  (.env commit edilmez)
# Değişkenler apps/api/src/config.ts içinde doğrulanır.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Ters vekil arkasında true; yalnız vekilin eklediği IP başlığına güvenilir.
TRUST_PROXY=false

# compose.yaml'daki yerel PostgreSQL 16 (host portu 5433)
DATABASE_URL=postgres://kampus:kampus-yerel@127.0.0.1:5433/kampus

# En az 32 karakter rastgele değer: openssl rand -base64 32
BETTER_AUTH_SECRET=degistir-en-az-32-karakter-rastgele-deger
# API'nin dışarıdan görünen kök adresi; üretimde zorunlu.
BETTER_AUTH_URL=http://localhost:3000

# Virgülle ayrılmış izinli web kökenleri (tam eşleşme); CORS ve Better Auth aynı listeyi kullanır.
CORS_ORIGINS=http://localhost:5173
# Mobil uygulama şeması gibi tarayıcı dışı güvenilen kökenler.
TRUSTED_ORIGINS=kampus://

# Yalnız db:seed. Boşsa üretim dışında varsayılan demo parolası kullanılır; üretimde zorunlu.
DEMO_PASSWORD=
