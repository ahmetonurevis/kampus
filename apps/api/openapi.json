                    ],
                    "description": "Kurum türü: `school` ders + kazanım, `language_school` CEFR + beceri"
                  },
                  "enabledModules": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
