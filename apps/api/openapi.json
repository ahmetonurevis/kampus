                    },
                    "description": "Modül anahtarı → açık mı. school-core modül kaydındaki her modül listelenir; kapalı modülün API uçları 403 `module_disabled` döner"
                  },
                  "academicYear": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
