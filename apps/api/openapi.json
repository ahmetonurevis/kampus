{
  "openapi": "3.1.0",
  "info": {
    "title": "Kampüs API",
    "version": "0.1.0",
    "description": "Kampüs okul–veli–öğrenci platformu API’si. Kimlik uçları (`/api/v1/auth/*`) Better Auth’undur ve bu belgede yer almaz."
  },
  "components": {
    "schemas": {
      "ErrorResponseInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Kararlı, İngilizce, snake_case hata kodu"
          },
          "message": {
            "type": "string",
            "description": "Kullanıcıya gösterilebilir Türkçe mesaj"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "message"
              ]
            }
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "PageMetaInput": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Sayfa numarası (1’den başlar)"
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Sayfa boyutu"
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Filtre uygulanmış toplam kayıt sayısı"
          }
        },
        "required": [
          "page",
          "pageSize",
          "total"
        ]
      },
      "HealthInput": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "description": "Sunucu çalışıyor"
          },
          "database": {
            "type": "string",
            "const": "ok",
            "description": "Veritabanı bağlantısı sağlıklı"
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "MembershipLinkInput": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "student",
              "child",
              "teacher"
            ],
            "description": "Bağlantı türü: öğrenci kendi kaydı, veli çocuğu, öğretmen kaydı"
          },
          "recordId": {
            "type": "string",
            "description": "school-core kayıt kimliği"
          }
        },
        "required": [
          "kind",
          "recordId"
        ]
      },
      "MeInput": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "description": "Ad soyad"
              },
              "email": {
                "type": "string",
                "description": "Giriş e-postası"
              }
            },
            "required": [
              "id",
              "name",
              "email"
            ]
          },
          "activeInstitution": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "school",
                      "language_school"
                    ],
                    "description": "Kurum türü: `school` ders + kazanım, `language_school` CEFR + beceri"
                  },
                  "enabledModules": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "boolean"
                    },
                    "description": "Modül anahtarı → açık mı. school-core modül kaydındaki her modül listelenir; kapalı modülün API uçları 403 `module_disabled` döner"
                  },
                  "academicYear": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Etkin eğitim-öğretim yılının (dönemin) başlangıç yılı: 2026 → 2026–2027. Kurum ayarı yoksa `null`"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "slug",
                  "type",
                  "enabledModules",
                  "academicYear"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Oturumun etkin kurumu; üyelik yoksa `null`"
          },
          "activeMembership": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "yonetici",
                      "onburo",
                      "ogretmen",
                      "ogrenci",
                      "veli"
                    ]
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/MembershipLinkInput"
                    }
                  }
                },
                "required": [
                  "id",
                  "role",
                  "links"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Etkin kurumdaki üyelik ve school-core kayıt bağlantıları"
          },
          "memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "institutionId": {
                  "type": "string"
                },
                "institutionName": {
                  "type": "string"
                },
                "institutionType": {
                  "type": "string",
                  "enum": [
                    "school",
                    "language_school"
                  ],
                  "description": "Kurum türü: `school` ders + kazanım, `language_school` CEFR + beceri"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "yonetici",
                    "onburo",
                    "ogretmen",
                    "ogrenci",
                    "veli"
                  ]
                }
              },
              "required": [
                "id",
                "institutionId",
                "institutionName",
                "institutionType",
                "role"
              ]
            },
            "description": "Kullanıcının bütün kurum üyelikleri (kurum değiştirme için)"
          }
        },
        "required": [
          "user",
          "activeInstitution",
          "activeMembership",
          "memberships"
        ]
      },
      "InstitutionMembershipInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Üyelik kimliği"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Ad soyad"
          },
          "email": {
            "type": "string",
            "description": "Giriş e-postası"
          },
          "role": {
            "type": "string",
            "enum": [
              "yonetici",
              "onburo",
              "ogretmen",
              "ogrenci",
              "veli"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "Üyeliğin açıldığı an (UTC)"
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "email",
          "role",
          "createdAt"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Kararlı, İngilizce, snake_case hata kodu"
          },
          "message": {
