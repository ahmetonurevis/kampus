{
  "name": "@kampus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "test:pg": "node --test 'test/pg-*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "auth:schema": "auth generate --config better-auth.config.ts --output src/db/schema/auth.ts --yes && prettier --write src/db/schema/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "openapi": "node src/openapi.ts",
    "openapi:check": "node src/openapi.ts --check"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.10",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@kampus/school-core": "workspace:2.22.0",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/pg": "8.23.1",
    "auth": "1.7.10",
    "drizzle-kit": "0.31.11"
  }
}
