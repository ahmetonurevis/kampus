# Android derleme ortamı shell üzerinden veya .env.android dosyasından okunur.
# ANDROID_HOME=/yerel/android/sdk
# JAVA_HOME=/yerel/jdk

# Uygulama modu. Boş veya tanımsız: çevrimdışı demo (API, JWT veya ödeme anahtarı gerekmez).
# Değer verilirse uygulama bu API'ye bağlanır (ör. https://api.ornek.test). Üretim derlemesinde
# (export:web, APK) yalnız https kabul edilir; http://127.0.0.1:3000 gibi adresler yalnız
# geliştirmede (pnpm mobile) çalışır. Değer derlemede pakete gömülür; sır yazılmaz, yalnız API kök adresi.
# Geçersiz adreste demo açılmaz, "Uygulama yapılandırması geçersiz" ekranı gösterilir.
# Yerelde .env.local'a yazın; mod değiştirince Metro önbelleğini temizleyin (--clear).
EXPO_PUBLIC_API_URL=
