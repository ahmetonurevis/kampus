{
  "name": "kampus-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kampus/web dev",
    "build": "pnpm --filter @kampus/web build",
    "preview": "pnpm --filter @kampus/web preview",
    "deploy": "bash scripts/deploy.sh",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "mobile": "pnpm --filter @kampus/mobile start",
    "build:apk": "bash scripts/build-android.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-x": "5.21.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
