{
  "name": "kampus-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kampus/web dev",
    "dev:react": "pnpm --filter @kampus/web-react dev",
    "dev:api": "pnpm --filter @kampus/api dev",
    "build": "pnpm --filter @kampus/web --filter @kampus/web-react build",
    "preview": "pnpm --filter @kampus/web preview",
    "deploy": "bash scripts/deploy.sh",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/e2e-react/tsconfig.json && tsc -p tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "pnpm --filter @kampus/api openapi && pnpm --filter @kampus/api-client generate",
    "test": "node --test tests/*.test.ts apps/web-react/tests/*.test.ts",
    "test:hooks": "node --test tests/hooks/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:react": "playwright test -c playwright.react.config.ts",
    "mobile": "pnpm --filter @kampus/mobile start",
    "build:apk": "bash scripts/build-android.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.21.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
