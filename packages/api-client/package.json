{
  "name": "@kampus/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "check": "pnpm run generate:check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 'test/**/*.test.ts'"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
